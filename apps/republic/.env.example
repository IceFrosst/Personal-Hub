# Shared Supabase public values. Applicant numbers use these client-side.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private server-to-server bridge to Lock In's existing Google Calendar
# connection. Source the stable Lock In base URL from apps/hub/config/apps.json
# and append /api/calendar/free-days when setting the Vercel value; do not
# hardcode a second cross-app URL in application code.
# LOCK_IN_CALENDAR_API_URL=
# REPUBLIC_CALENDAR_API_SECRET=

# Optional; defaults to Europe/Vilnius.
# GOOGLE_CALENDAR_TIME_ZONE=Europe/Vilnius
