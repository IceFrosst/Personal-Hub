# Optional Supabase integration. Without these, applicant numbers remain a
# placeholder and application/appointment/bribe records use localStorage.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for /appointment. Without all three required values, availability
# fails closed and the funnel cannot book an appointment. These are server-only:
# never prefix them NEXT_PUBLIC_ or expose them to the browser.
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional; defaults to Europe/Vilnius.
# GOOGLE_CALENDAR_TIME_ZONE=Europe/Vilnius

# Manual one-time Google setup (credentials are not available in this repo):
#   1. Enable the Google Calendar API and create a service account + JSON key.
#   2. Share the target calendar with the service-account email using
#      “See only free/busy (hide details)” (freeBusyReader) permission.
#   3. Copy that calendar's ID from Settings → Integrate calendar. Do not use
#      `primary`, which refers to the service account's own calendar.
#   4. Set the three required vars above in Vercel; set timezone only to
#      override the Europe/Vilnius default.
