# Shared Supabase project. The public values support the applicant-number RPC;
# the server-only service-role key lets Republic read Ignas's existing Lock In
# calendar refresh-token row. Never prefix the service-role key NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Reuse Lock In's existing Google Calendar OAuth connection. These are the same
# OAuth client credentials already configured on the Lock In Vercel project;
# Republic does not need another consent screen or a service account.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_ACCOUNT_EMAIL=ign3107s@gmail.com

# Optional; defaults to Europe/Vilnius.
# GOOGLE_CALENDAR_TIME_ZONE=Europe/Vilnius
